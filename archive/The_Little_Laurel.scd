  "pages": [
    "<h1 style=\"text-align: center;\"><span style=\"font-family: Manufacturing Consent;\"><span style=\"font-weight: normal; font-size: 42pt;\"><br></span></span></h1><h1 style=\"text-align: center;\"><span style=\"font-size: 42pt; font-weight: normal; font-family: Manufacturing Consent;\"><br></span></h1><h1 style=\"text-align: center;\"><span style=\"font-size: 42pt; font-weight: normal; font-family: Manufacturing Consent;\"><br></span></h1><h1 style=\"text-align: center;\"><span style=\"font-size: 42pt; font-weight: normal; font-family: Manufacturing Consent;\"><br></span></h1><h1 style=\"text-align: center;\"><span style=\"font-family: Manufacturing Consent; font-size: 44pt; font-weight: normal;\"><font color=\"#52604a\">The Little Laurel</font></span></h1><div style=\"text-align: center;\"><span style=\"font-family: Felipa; font-size: 18pt;\"><b style=\"font-size: 21pt;\"><font color=\"#765640\">A table for every season</font></b></span></div><div style=\"text-align: center;\"><span style=\"font-family: Felipa; font-size: 18pt;\"><b><br></b></span></div><div style=\"text-align: center;\"><span style=\"font-family: Felipa; font-size: 18pt;\"><b><span style=\"font-family: Crimson Text; font-size: 14pt;\"></span></b></span></div><div style=\"text-align: center;\"><span style=\"font-family: Felipa; font-size: 18pt;\"><b><span style=\"font-family: Aboreto; font-size: 12pt;\"><font color=\"#a39287\">Rua das Flores 55, São Paulo</font></span></b></span></div><div></div><div><br></div><div><br></div>",
    "<div style=\"text-align: justify;\"><b style=\"font-family: Great Vibes; font-size: 22pt;\"><font color=\"#68735a\">MAIN&nbsp; &nbsp; COURSE</font></b></div><div style=\"text-align: justify;\"><br></div><div style=\"text-align: justify; font-size: 14pt;\"><span style=\"font-family: Redressed;\"><font color=\"#29261f\">Herb-Roasted Chicken — Roasted chicken, garden herbs, garlic jus - </font><span style=\"font-family: Uncial Antiqua;\"><font color=\"#a77b45\">110$</font></span></span></div><div style=\"text-align: justify; font-size: 14pt;\"><span style=\"font-family: Redressed;\"><font color=\"#29261f\">Truffle Mushroom Risotto — Arborio rice, wild mushrooms, parmesan, truffle oil - </font><span style=\"font-family: Uncial Antiqua;\"><font color=\"#a77b45\">250$</font></span></span></div><div style=\"text-align: justify; font-size: 14pt;\"><span style=\"font-family: Redressed;\"><font color=\"#29261f\">Seared Salmon — Lemon butter, roasted vegetables, fresh herbs - </font><span style=\"font-family: Uncial Antiqua;\"><font color=\"#a77b45\">100$</font></span></span></div><div style=\"text-align: justify; font-size: 14pt;\"><span style=\"font-family: Redressed;\"><font color=\"#29261f\">Braised Beef Short Rib — Slow-cooked beef, creamy mash, red wine jus - </font><span style=\"font-family: Uncial Antiqua;\"><font color=\"#a77b45\">350$</font></span></span></div><div style=\"text-align: justify; font-size: 14pt;\"><span style=\"font-family: Redressed;\"><font color=\"#29261f\">Wild Mushroom Tagliatelle — Handmade pasta, mushrooms, parmesan, sage - </font><span style=\"font-family: Uncial Antiqua;\"><font color=\"#a77b45\">425$</font></span></span></div><div style=\"text-align: justify; font-size: 14pt;\"><span style=\"font-family: Redressed;\"><font color=\"#29261f\">Classic Beef Tenderloin — Grilled tenderloin, potato gratin, peppercorn sauce - </font><span style=\"font-family: Uncial Antiqua;\"><font color=\"#a77b45\">250$</font></span></span></div><div style=\"text-align: justify; font-size: 14pt;\"><span style=\"font-family: Redressed;\"><font color=\"#29261f\">Roasted Vegetable Tart — Seasonal vegetables, goat cheese, herbs - </font><span style=\"font-family: Uncial Antiqua;\"><font color=\"#a77b45\">150$</font></span></span></div><div style=\"text-align: justify; font-size: 14pt;\"><span style=\"font-family: Redressed;\"><font color=\"#29261f\">Pan-Seared Sea Bass — Seasonal greens, lemon beurre blanc - </font><span style=\"font-family: Uncial Antiqua;\"><font color=\"#a77b45\">300$</font></span></span></div><div style=\"text-align: justify; font-size: 14pt;\"><span style=\"font-family: Redressed;\"><font color=\"#29261f\">Garden Gnocchi — Potato gnocchi, tomato, basil, burrata - </font><span style=\"font-family: Uncial Antiqua;\"><font color=\"#a77b45\">580$</font></span></span></div><div style=\"text-align: justify; font-size: 14pt;\"><span style=\"font-family: Redressed;\"><font color=\"#29261f\">Ember-Grilled Lamb — Herb crust, roasted potatoes, rosemary jus - </font><span style=\"font-family: Uncial Antiqua;\"><font color=\"#a77b45\">1000$</font></span></span></div><div style=\"text-align: justify; font-size: 14pt;\"><span style=\"font-family: Redressed;\"><span style=\"font-family: Uncial Antiqua;\"><br></span></span></div><div style=\"text-align: justify; font-size: 14pt;\"><span style=\"font-family: Redressed;\"><span style=\"font-family: Uncial Antiqua;\"><br></span></span></div><div style=\"text-align: justify; font-size: 14pt;\"><span style=\"font-family: Redressed;\"><span style=\"font-family: Great Vibes; font-size: 22pt;\"><b><font color=\"#68735a\">Sides</font></b></span></span></div><div style=\"text-align: justify; font-size: 14pt;\"><br></div><div style=\"text-align: justify; font-size: 14pt;\"><span style=\"font-family: Redressed;\"><font color=\"#29261f\">Truffle Parmesan Fries — Crisp golden fries, shaved black truffle, truffle aioli - </font><b style=\"\"><span style=\"font-family: Uncial Antiqua;\"><font color=\"#a77b45\">180$</font></span></b></span></div><div style=\"text-align: justify; font-size: 14pt;\"><span style=\"font-family: Redressed;\"><font color=\"#29261f\">Roasted Garlic Potatoes — Golden potatoes, confit garlic, rosemary, cultured butter - </font><b style=\"\"><span style=\"font-family: Uncial Antiqua;\"><font color=\"#a77b45\">150$</font></span></b></span></div><div style=\"text-align: justify; font-size: 14pt;\"><span style=\"font-family: Redressed;\"><font color=\"#29261f\">Wild Mushroom Medley — Woodland mushrooms, shallots, thyme, brown butter - </font><b style=\"\"><span style=\"font-family: Uncial Antiqua;\"><font color=\"#a77b45\">225$</font></span></b></span></div><div style=\"text-align: justify; font-size: 14pt;\"><span style=\"font-family: Redressed;\"><font color=\"#29261f\">Charred Asparagus — Fire-charred asparagus, lemon zest, parmesan cream - </font><b style=\"\"><span style=\"font-family: Uncial Antiqua;\"><font color=\"#a77b45\">175$</font></span></b></span></div><div style=\"text-align: justify; font-size: 14pt;\"><span style=\"font-family: Redressed;\"><font color=\"#29261f\">Buttered Baby Carrots — Tender baby carrots, French butter, wildflower honey, herbs - </font><b style=\"\"><span style=\"font-family: Uncial Antiqua;\"><font color=\"#a77b45\">125$</font></span></b></span></div><div style=\"text-align: justify; font-size: 14pt;\"><span style=\"font-family: Redressed;\"><font color=\"#29261f\">Parmesan Creamed Spinach — Silky spinach, aged parmesan, cream, roasted garlic - </font><b style=\"\"><span style=\"font-family: Uncial Antiqua;\"><font color=\"#a77b45\">200$</font></span></b></span></div><div style=\"text-align: justify; font-size: 14pt;\"><span style=\"font-family: Redressed;\"><font color=\"#29261f\">Truffle Mac &amp; Cheese — Hand-cut pasta, aged cheddar, Gruyère, black truffle - </font><b style=\"\"><span style=\"font-family: Uncial Antiqua;\"><font color=\"#a77b45\">350$</font></span></b></span></div><div style=\"text-align: justify; font-size: 14pt;\"><span style=\"font-family: Redressed;\"><font color=\"#29261f\">Roasted Seasonal Vegetables — Market vegetables, olive oil, herbs, balsamic glaze - </font><b style=\"\"><span style=\"font-family: Uncial Antiqua;\"><font color=\"#a77b45\">160$</font></span></b></span></div><div style=\"text-align: justify; font-size: 14pt;\"><span style=\"font-family: Redressed;\"><font color=\"#29261f\">Potato Gratin — Layered potatoes, cream, Gruyère, roasted garlic - </font><b style=\"\"><span style=\"font-family: Uncial Antiqua;\"><font color=\"#a77b45\">275$</font></span></b></span></div><div style=\"text-align: justify; font-size: 14pt;\"><span style=\"font-family: Redressed;\"><font color=\"#29261f\">Honey-Glazed Root Vegetables — Heirloom root vegetables, wildflower honey, butter - </font><b style=\"\"><span style=\"font-family: Uncial Antiqua;\"><font color=\"#a77b45\">140$</font></span></b></span></div><div style=\"text-align: justify; font-size: 14pt;\"><br></div>",
    "<span style=\"font-family: Great Vibes;\"><b style=\"font-size: 16pt;\"><font color=\"#68735a\">OUR&nbsp; &nbsp; STORY</font></b></span><div><br></div><div style=\"text-align: justify;\"><font color=\"#29261f\">A TABLE WORTH GATHERING AROUND. Rooted in timeless flavors and guided by the seasons, our kitchen brings together carefully chosen ingredients, thoughtful technique, and a little imagination. Every dish is made to be savored slowly, shared generously, and remembered long after the last bite.</font></div><div><br></div><div><br></div><div style=\"font-size: 16pt;\"><span style=\"font-family: Great Vibes;\"><b><font color=\"#68735a\">FROM&nbsp; &nbsp; OUR&nbsp; &nbsp; KITCHEN</font></b></span></div><div><br></div><div><font color=\"#29261f\">Seasonal ingredients. Thoughtful cooking.</font></div><div><font color=\"#29261f\">Every plate prepared with patience and purpose.</font></div><div><br></div><div><br></div><div><span style=\"font-size: 16pt; font-family: Great Vibes;\"><b><font color=\"#68735a\">PRIVATE&nbsp; &nbsp; DINING</font></b></span></div><div><br></div><div><font color=\"#29261f\">An intimate setting for celebrations,</font></div><div><font color=\"#29261f\">gatherings, and unforgettable evenings.</font></div><div><font color=\"#29261f\"><br></font></div><div><font color=\"#29261f\">+55-11-91234-5678</font></div><div><font color=\"#29261f\">thelittle@laurel.com</font></div><div><font color=\"#29261f\">www.theluarelparadise.com</font></div><div><br></div><div><br></div><div><font face=\"Great Vibes\" color=\"#68735a\"><span style=\"font-size: 21.3333px;\"><b>VISIT&nbsp; &nbsp;US</b></span></font></div><div><br></div><div><font color=\"#29261f\">Rua das Flores 55, São Paulo</font></div><div><font color=\"#29261f\">Monday — Thursday: 6:00 PM — 11:00 PM</font></div><div><font color=\"#29261f\">Friday — Saturday: 6:00 PM — 12:00 AM</font></div><div><font color=\"#29261f\">Sunday: Closed</font></div><div><br></div><div><br></div><div><br></div><div><br></div><div><br></div><div style=\"text-align: center;\"><span style=\"font-family: Stardos Stencil;\"><font color=\"#a39287\">•-• GOOD FOOD •-•</font></span></div><div style=\"text-align: center;\"><span style=\"font-family: Stardos Stencil;\"><font color=\"#a39287\">•-• GOOD COMPANY •-•</font></span></div><div style=\"text-align: center;\"><span style=\"font-family: Stardos Stencil;\"><font color=\"#a39287\">•-• GOOD MEMORIES •-•</font></span></div><div><br></div>"
  ],
